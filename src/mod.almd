// Minecraft chunk data for 1.21.1.
// Reference: https://minecraft.wiki/w/Java_Edition_protocol/Chunk_format
//
// A chunk is 16x384x16 blocks (24 sections of 16x16x16).
// Each section uses a paletted container for block states.
//
// Usage:
//   import mc_chunk
//   let section = mc_chunk.new_section()
//   let s2 = mc_chunk.set_block(section, 0, 0, 0, 1)
//   let block_id = mc_chunk.get_block(s2, 0, 0, 0)

// --- Constants ---

let SECTION_WIDTH = 16
let SECTION_HEIGHT = 16
let SECTION_VOLUME = 4096
let CHUNK_SECTIONS = 24
let CHUNK_MIN_Y = -64
let CHUNK_MAX_Y = 319
let CHUNK_HEIGHT = 384

// --- Section (16x16x16 block states) ---

type ChunkSection = {
  palette: List[Int],
  blocks: List[Int],
  block_count: Int,
}

fn new_section() -> ChunkSection = {
  { palette: [0], blocks: list.repeat(0, SECTION_VOLUME), block_count: 0 }
}

// Get block state at local coordinates (0-15 each)
fn get_block(section: ChunkSection, x: Int, y: Int, z: Int) -> Int = {
  let index = y * 256 + z * 16 + x
  let palette_index = list.get(section.blocks, index) ?? 0
  list.get(section.palette, palette_index) ?? 0
}

// Set block state at local coordinates
fn set_block(section: ChunkSection, x: Int, y: Int, z: Int, block_id: Int) -> ChunkSection = {
  let index = y * 256 + z * 16 + x
  // Find or add to palette
  let palette_index = find_or_add_palette(section.palette, block_id)
  let old_palette_idx = list.get(section.blocks, palette_index.index) ?? 0
  let old_id = list.get(section.palette, old_palette_idx) ?? 0
  let new_blocks = list.set(section.blocks, index, palette_index.index)
  // Update block count
  let delta = if block_id != 0 and old_id == 0 then 1
    else if block_id == 0 and old_id != 0 then -1
    else 0
  { palette: palette_index.palette, blocks: new_blocks, block_count: section.block_count + delta }
}

local fn find_or_add_palette(palette: List[Int], block_id: Int) -> { palette: List[Int], index: Int } = {
  var found = -1
  for i in 0..<list.length(palette) {
    if (list.get(palette, i) ?? -1) == block_id then { found = i } else { () }
  }
  if found >= 0 then { palette: palette, index: found }
  else { palette: palette + [block_id], index: list.length(palette) }
}

// --- Chunk (24 sections) ---

type Chunk = {
  x: Int,
  z: Int,
  sections: List[ChunkSection],
}

fn new_chunk(chunk_x: Int, chunk_z: Int) -> Chunk = {
  { x: chunk_x, z: chunk_z, sections: list.repeat(new_section(), CHUNK_SECTIONS) }
}

// Convert world Y to section index (0-23)
fn section_index(world_y: Int) -> Int =
  (world_y - CHUNK_MIN_Y) / 16

// Get block at world coordinates within chunk
fn get_world_block(chunk: Chunk, x: Int, y: Int, z: Int) -> Int = {
  let sec_idx = section_index(y)
  let section = list.get(chunk.sections, sec_idx) ?? new_section()
  get_block(section, x % 16, y % 16, z % 16)
}

// Set block at world coordinates within chunk
fn set_world_block(chunk: Chunk, x: Int, y: Int, z: Int, block_id: Int) -> Chunk = {
  let sec_idx = section_index(y)
  let section = list.get(chunk.sections, sec_idx) ?? new_section()
  let updated = set_block(section, x % 16, y % 16, z % 16, block_id)
  { ...chunk, sections: list.set(chunk.sections, sec_idx, updated) }
}

// --- Chunk column tracker ---

type ChunkTracker = {
  chunks: List[Chunk],
}

fn new_tracker() -> ChunkTracker = { chunks: [] }

fn get_chunk(tracker: ChunkTracker, cx: Int, cz: Int) -> Option[Chunk] = {
  var found: Option[Chunk] = none
  for c in tracker.chunks {
    if c.x == cx and c.z == cz then { found = some(c) } else { () }
  }
  found
}

fn set_chunk(tracker: ChunkTracker, chunk: Chunk) -> ChunkTracker = {
  let filtered = list.filter(tracker.chunks, (c) => not (c.x == chunk.x and c.z == chunk.z))
  { chunks: filtered + [chunk] }
}

fn unload_chunk(tracker: ChunkTracker, cx: Int, cz: Int) -> ChunkTracker = {
  { chunks: list.filter(tracker.chunks, (c) => not (c.x == cx and c.z == cz)) }
}

fn loaded_count(tracker: ChunkTracker) -> Int =
  list.length(tracker.chunks)

// --- Tests ---

test "new section is all air" {
  let s = new_section()
  assert_eq(get_block(s, 0, 0, 0), 0)
  assert_eq(get_block(s, 15, 15, 15), 0)
  assert_eq(s.block_count, 0)
}

test "set and get block" {
  let s = set_block(new_section(), 5, 10, 3, 1)
  assert_eq(get_block(s, 5, 10, 3), 1)
  assert_eq(get_block(s, 0, 0, 0), 0)
}

test "palette grows" {
  var s = new_section()
  s = set_block(s, 0, 0, 0, 1)
  s = set_block(s, 1, 0, 0, 2)
  s = set_block(s, 2, 0, 0, 3)
  assert_eq(list.length(s.palette), 4)
  assert_eq(get_block(s, 0, 0, 0), 1)
  assert_eq(get_block(s, 1, 0, 0), 2)
  assert_eq(get_block(s, 2, 0, 0), 3)
}

test "section_index" where [
  "y=-64 (bottom)"  [y = -64, want = 0],
  "y=0 (sea level area)" [y = 0, want = 4],
  "y=64"  [y = 64, want = 8],
  "y=319 (top)" [y = 319, want = 23],
] {
  assert_eq(section_index(y), want)
}

test "chunk constants" {
  assert_eq(CHUNK_MIN_Y, -64)
  assert_eq(CHUNK_MAX_Y, 319)
  assert_eq(CHUNK_HEIGHT, 384)
  assert_eq(CHUNK_SECTIONS, 24)
}

test "new chunk" {
  let c = new_chunk(0, 0)
  assert_eq(c.x, 0)
  assert_eq(c.z, 0)
  assert_eq(list.length(c.sections), CHUNK_SECTIONS)
}

test "chunk tracker" {
  var t = new_tracker()
  assert_eq(loaded_count(t), 0)
  t = set_chunk(t, new_chunk(0, 0))
  t = set_chunk(t, new_chunk(1, 0))
  assert_eq(loaded_count(t), 2)
  assert_ne(get_chunk(t, 0, 0), none)
  assert_eq(get_chunk(t, 5, 5), none)
  t = unload_chunk(t, 0, 0)
  assert_eq(loaded_count(t), 1)
}

test "set_world_block and get_world_block" {
  let c = set_world_block(new_chunk(0, 0), 5, 64, 3, 42)
  assert_eq(get_world_block(c, 5, 64, 3), 42)
  assert_eq(get_world_block(c, 0, 0, 0), 0)
}

test "find_or_add_palette reuses existing" {
  let r1 = find_or_add_palette([0, 1, 2], 1)
  assert_eq(r1.index, 1)
  assert_eq(list.length(r1.palette), 3)
}

test "find_or_add_palette adds new" {
  let r = find_or_add_palette([0, 1], 5)
  assert_eq(r.index, 2)
  assert_eq(list.length(r.palette), 3)
}
